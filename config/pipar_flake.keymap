#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE        0
#define FUNC        1

/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1>;
        triggers-per-rotation = <24>;
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(H) &kp A &kp P &kp P &kp Y &kp SPACE &kp LS(B) &kp I &kp R &kp T &kp H &kp D &kp A &kp Y>;
            label = "NEW_MACRO";
        };

        yt: yt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp Y &kp O &kp U &kp T &kp U &kp B &kp E &kp DOT &kp C &kp O &kp M>;
            label = "YT";
        };
    };

    behaviors {
        b_doubletap: b_doubletap {
            compatible = "zmk,behavior-tap-dance";
            label = "B_DOUBLETAP";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDER>;
        };

        c_doubletap: c_doubletap {
            compatible = "zmk,behavior-tap-dance";
            label = "C_DOUBLETAP";
            #binding-cells = <0>;
            bindings = <&kp C>, <&yt>;
        };
    };

    combos {
        compatible = "zmk,combos";

        zcob {
            bindings = <&kp ESCAPE>;
            key-positions = <6 8>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------//
            // | Q    | W     | ENCODER | //
            // | A    | S     | D       | //
            // | Z    | X     | FN      | //

            display-name = "default";
            bindings = <
&b_doubletap    &kp LEFT_WIN    &to 1
&kp BACKSPACE   &kp UP_ARROW    &kp ENTER
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        function_layer {
            // --------------------------- //
            // | BT_CLR | none | ENCODER | //
            // | BT_0   | BT_1 | BT_2    | //
            // | BT_3   | BT_4 | trans   | //

            display-name = "function";
            bindings = <
&bt BT_CLR    &none         &to 2
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2
&bt BT_SEL 3  &bt BT_SEL 4  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_2 {
            bindings = <
&kp C_PAUSE  &c_doubletap  &to 0
&kp INS      &kp HOME      &kp PG_UP
&kp DELETE   &kp END       &kp PAGE_DOWN
            >;
        };

        layer_3 {
            bindings = <
&kp A   &kp H   &trans
&trans  &trans  &trans
&trans  &trans  &trans
            >;
        };
    };
};
